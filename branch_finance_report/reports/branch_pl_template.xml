<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="branch_pl_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc.get_pl_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ══ Report Header ══ -->
                        <style>
                            .brpt-header { background: #1a1a2e; color: #ffffff; padding: 16px 20px; margin-bottom: 20px; border-radius: 4px; }
                            .brpt-header h2 { margin: 0; font-size: 20px; font-weight: 700; }
                            .brpt-header .brpt-company { font-size: 12px; opacity: 0.75; margin-top: 2px; }
                            .brpt-header .brpt-period { font-size: 11px; opacity: 0.75; text-align: right; }
                            .brpt-branch-bar { background: rgba(255,255,255,0.12); border-left: 4px solid #ffc107; margin-top: 12px; padding: 8px 14px; border-radius: 0 3px 3px 0; }
                            .brpt-branch-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; opacity: 0.7; margin-bottom: 2px; }
                            .brpt-branch-name { font-size: 16px; font-weight: 800; letter-spacing: 0.3px; color: #ffc107; }
                            .brpt-section-header { padding: 8px 12px; color: #fff; font-weight: 700; font-size: 13px; margin-top: 16px; }
                            .brpt-income-header { background: #1e7e34; }
                            .brpt-expense-header { background: #bd2130; }
                            .brpt-table { width: 100%; border-collapse: collapse; font-size: 12px; }
                            .brpt-table th { background: #f8f9fa; border-bottom: 2px solid #dee2e6; padding: 7px 10px; text-align: left; font-weight: 600; }
                            .brpt-table th.text-right, .brpt-table td.text-right { text-align: right; }
                            .brpt-table td { border-bottom: 1px solid #e9ecef; padding: 6px 10px; }
                            .brpt-table tr:nth-child(even) td { background: #f8f9fa; }
                            .brpt-subtotal td { background: #e9ecef !important; font-weight: 700; border-top: 2px solid #adb5bd; }
                            .brpt-net-profit td { font-size: 14px; font-weight: 700; border-top: 3px double #1a1a2e; }
                            .text-success { color: #28a745; }
                            .text-danger { color: #dc3545; }
                            .text-right { text-align: right; }
                        </style>

                        <div class="brpt-header">
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="vertical-align:top;">
                                        <h2>Profit &amp; Loss Statement</h2>
                                        <div class="brpt-company"><t t-esc="doc.company_id.name"/></div>
                                    </td>
                                    <td style="vertical-align:top;text-align:right;">
                                        <div class="brpt-period">Period</div>
                                        <div style="font-size:13px;font-weight:700;"><t t-esc="doc.date_from"/> &#8212; <t t-esc="doc.date_to"/></div>
                                    </td>
                                </tr>
                            </table>
                            <div class="brpt-branch-bar">
                                <div class="brpt-branch-label">Branch</div>
                                <div class="brpt-branch-name"><t t-esc="data['branches']"/></div>
                            </div>
                        </div>


                        <!-- ══ Income Section ══ -->
                        <div class="brpt-section-header brpt-income-header">INCOME</div>
                        <table class="brpt-table">
                            <thead>
                                <tr>
                                    <th style="width:15%">Code</th>
                                    <th>Account</th>
                                    <th class="text-right" style="width:20%">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['income']" t-as="row">
                                    <tr>
                                        <td><t t-esc="row['code']"/></td>
                                        <td><t t-esc="row['account']"/></td>
                                        <td class="text-right">
                                            <t t-esc="row['balance']"
                                               t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not data['income']">
                                    <tr><td colspan="3" style="text-align:center;color:#6c757d;font-style:italic;">No income entries</td></tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="brpt-subtotal">
                                    <td colspan="2">Total Income</td>
                                    <td class="text-right text-success">
                                        <t t-esc="data['total_income']"
                                           t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ══ Expense Section ══ -->
                        <div class="brpt-section-header brpt-expense-header">EXPENSES</div>
                        <table class="brpt-table">
                            <thead>
                                <tr>
                                    <th style="width:15%">Code</th>
                                    <th>Account</th>
                                    <th class="text-right" style="width:20%">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['expense']" t-as="row">
                                    <tr>
                                        <td><t t-esc="row['code']"/></td>
                                        <td><t t-esc="row['account']"/></td>
                                        <td class="text-right">
                                            <t t-esc="row['balance']"
                                               t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not data['expense']">
                                    <tr><td colspan="3" style="text-align:center;color:#6c757d;font-style:italic;">No expense entries</td></tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="brpt-subtotal">
                                    <td colspan="2">Total Expenses</td>
                                    <td class="text-right text-danger">
                                        <t t-esc="data['total_expense']"
                                           t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ══ Net Profit / Loss ══ -->
                        <table class="brpt-table" style="margin-top:20px;">
                            <tbody>
                                <tr class="brpt-net-profit">
                                    <td style="width:80%">
                                        <t t-if="data['net_profit'] >= 0">NET PROFIT</t>
                                        <t t-else="">NET LOSS</t>
                                    </td>
                                    <td class="text-right"
                                        t-attf-style="color: {{ '#28a745' if data['net_profit'] >= 0 else '#dc3545' }}">
                                        <t t-esc="data['net_profit']"
                                           t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ══ Footer note ══ -->
                        <p style="margin-top:30px;font-size:10px;color:#6c757d;">
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            — Branch Financial Reports by leapai.ai
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
