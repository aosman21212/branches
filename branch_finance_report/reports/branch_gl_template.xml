<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="branch_gl_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc.get_gl_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <style>
                                                        .brpt-header { background: #1a1a2e; color: #ffffff; padding: 16px 20px; margin-bottom: 20px; border-radius: 4px; }
                            .brpt-header h2 { margin: 0; font-size: 20px; font-weight: 700; }
                            .brpt-header .brpt-company { font-size: 12px; opacity: 0.75; margin-top: 2px; }
                            .brpt-header .brpt-period { font-size: 11px; opacity: 0.75; text-align: right; }
                            .brpt-branch-bar { background: rgba(255,255,255,0.12); border-left: 4px solid #ffc107; margin-top: 12px; padding: 8px 14px; border-radius: 0 3px 3px 0; }
                            .brpt-branch-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.2px; opacity: 0.7; margin-bottom: 2px; }
                            .brpt-branch-name { font-size: 16px; font-weight: 800; letter-spacing: 0.3px; color: #ffc107; }
                            .brpt-account-header { background: #1a1a2e; color: #fff; padding: 7px 10px; font-weight: 700; font-size: 12px; margin-top: 18px; }
                            .brpt-table { width: 100%; border-collapse: collapse; font-size: 11px; }
                            .brpt-table th { background: #343a40; color: #fff; padding: 6px 8px; font-weight: 600; }
                            .brpt-table th.text-right, .brpt-table td.text-right { text-align: right; }
                            .brpt-table td { border-bottom: 1px solid #e9ecef; padding: 5px 8px; }
                            .brpt-table tr:nth-child(even) td { background: #f8f9fa; }
                            .brpt-account-total td { background: #dee2e6 !important; font-weight: 700; border-top: 2px solid #adb5bd; }
                            .text-right { text-align: right; }
                            .text-muted { color: #6c757d; }
                        </style>

                        <div class="brpt-header">
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="vertical-align:top;">
                                        <h2>General Ledger</h2>
                                        <div class="brpt-company"><t t-esc="doc.company_id.name"/></div>
                                    </td>
                                    <td style="vertical-align:top;text-align:right;">
                                        <div class="brpt-period">Period</div>
                                        <div style="font-size:13px;font-weight:700;"><t t-esc="doc.date_from"/> &#8212; <t t-esc="doc.date_to"/></div>
                                    </td>
                                </tr>
                            </table>
                            <div class="brpt-branch-bar">
                                <div class="brpt-branch-label">Branch</div>
                                <div class="brpt-branch-name"><t t-esc="data['branches']"/></div>
                            </div>
                        </div>


                        <t t-if="not data['accounts']">
                            <p style="text-align:center;color:#6c757d;font-style:italic;margin-top:30px;">
                                No entries found for the selected period and filters.
                            </p>
                        </t>

                        <t t-foreach="data['accounts']" t-as="account">
                            <!-- Account Header -->
                            <div class="brpt-account-header">
                                <t t-esc="account['code']"/> — <t t-esc="account['account']"/>
                            </div>

                            <table class="brpt-table">
                                <thead>
                                    <tr>
                                        <th style="width:9%">Date</th>
                                        <th style="width:13%">Reference</th>
                                        <th style="width:14%">Partner</th>
                                        <th>Description</th>
                                        <th style="width:10%">Branch</th>
                                        <th class="text-right" style="width:10%">Debit</th>
                                        <th class="text-right" style="width:10%">Credit</th>
                                        <th class="text-right" style="width:10%">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="account['lines']" t-as="line">
                                        <tr>
                                            <td><t t-esc="line['date']"/></td>
                                            <td><t t-esc="line['move']"/></td>
                                            <td><t t-esc="line['partner']"/></td>
                                            <td><t t-esc="line['label']"/></td>
                                            <td><t t-esc="line['branch']"/></td>
                                            <td class="text-right">
                                                <t t-if="line['debit']">
                                                    <t t-esc="line['debit']"
                                                       t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-right">
                                                <t t-if="line['credit']">
                                                    <t t-esc="line['credit']"
                                                       t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                                </t>
                                            </td>
                                            <td class="text-right"
                                                t-attf-style="color: {{ '#28a745' if line['balance'] >= 0 else '#dc3545' }}">
                                                <t t-esc="line['balance']"
                                                   t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="brpt-account-total">
                                        <td colspan="5">Account Total</td>
                                        <td class="text-right">
                                            <t t-esc="account['total_debit']"
                                               t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-esc="account['total_credit']"
                                               t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                        <td class="text-right"
                                            t-attf-style="color: {{ '#28a745' if account['total_balance'] >= 0 else '#dc3545' }}">
                                            <t t-esc="account['total_balance']"
                                               t-options="{'widget': 'monetary', 'display_currency': doc.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <p style="margin-top:30px;font-size:10px;color:#6c757d;">
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            — Branch Financial Reports by leapai.ai
                        </p>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
