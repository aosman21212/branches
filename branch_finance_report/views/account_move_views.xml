<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Inherit account.move form — add branch_id after journal_id ── -->
        <record id="view_move_form_branch" model="ir.ui.view">
            <field name="name">account.move.form.branch</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="branch_id" options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <!-- ── Inherit account.move list — add branch_id column ── -->
        <record id="view_move_list_branch" model="ir.ui.view">
            <field name="name">account.move.list.branch</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="branch_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <!-- ── Inherit account.move search — add branch filter ── -->
        <record id="view_move_search_branch" model="ir.ui.view">
            <field name="name">account.move.search.branch</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[last()]" position="after">
                    <field name="branch_id"/>
                    <filter string="Has Branch" name="has_branch"
                            domain="[('branch_id', '!=', False)]"/>
                </xpath>
                <xpath expr="//search/group[last()]" position="inside">
                    <filter string="Branch" name="group_branch"
                            context="{'group_by': 'branch_id'}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
