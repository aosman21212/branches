<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Form View ── -->
        <record id="view_branch_unit_form" model="ir.ui.view">
            <field name="name">branch.unit.form</field>
            <field name="model">branch.unit</field>
            <field name="arch" type="xml">
                <form string="Branch Unit">
                    <header/>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_moves"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-book">
                                <field name="move_count" widget="statinfo" string="Journal Entries"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Branch Name"/>
                            </h1>
                            <label for="code"/>
                            <h2>
                                <field name="code" placeholder="Code"/>
                            </h2>
                        </div>
                        <group>
                            <group string="General Information">
                                <field name="company_id"/>
                                <field name="manager_id"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group string="Address">
                                <field name="street"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="note" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ── List View ── -->
        <record id="view_branch_unit_list" model="ir.ui.view">
            <field name="name">branch.unit.list</field>
            <field name="model">branch.unit</field>
            <field name="arch" type="xml">
                <list string="Branch Units">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="manager_id"/>
                    <field name="city"/>
                    <field name="phone"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ── Kanban View ── -->
        <record id="view_branch_unit_kanban" model="ir.ui.view">
            <field name="name">branch.unit.kanban</field>
            <field name="model">branch.unit</field>
            <field name="arch" type="xml">
                <kanban string="Branch Units" default_group_by="company_id">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="manager_id"/>
                    <field name="move_count"/>
                    <field name="city"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            [<field name="code"/>] <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div t-if="record.manager_id.value">
                                        <i class="fa fa-user" title="Manager"/> <field name="manager_id"/>
                                    </div>
                                    <div t-if="record.city.value">
                                        <i class="fa fa-map-marker" title="City"/> <field name="city"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><i class="fa fa-book" title="Journal Entries"/> <field name="move_count"/> Entries</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── Search View ── -->
        <record id="view_branch_unit_search" model="ir.ui.view">
            <field name="name">branch.unit.search</field>
            <field name="model">branch.unit</field>
            <field name="arch" type="xml">
                <search string="Search Branches">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="manager_id"/>
                    <field name="city"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                        <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Window Action ── -->
        <record id="action_branch_unit" model="ir.actions.act_window">
            <field name="name">Branches</field>
            <field name="res_model">branch.unit</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_branch_unit_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Branch
                </p>
                <p>
                    Branches let you filter financial reports by organisational unit.
                </p>
            </field>
        </record>

    </data>
</odoo>
